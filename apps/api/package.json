{
  "name": "@tutorlink/api",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && node scripts/prepare-assets.mjs && tsc -p tsconfig.json",
    "vercel-build": "npm run build",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:preflight": "tsx src/scripts/db-tools.ts preflight",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "tsx src/scripts/db-tools.ts verify",
    "db:setup": "npm run db:preflight && npm run db:deploy && npm run db:verify",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "~6.19.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
