NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---- Database (use a NEW, EMPTY Neon database for this project) ----
# DATABASE_URL: Neon *pooled* connection string (host contains "-pooler") + ?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL:   Neon *direct* connection string (no "-pooler"), used only by migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---- Secrets: generate fresh random values (e.g. `openssl rand -hex 32`) ----
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARS
CRON_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARS
# Only used by `npm run admin:create`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD_AT_LEAST_12_CHARS

# ---- Meta (server-side only) ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=v26.0
# Keep dry-run until the staging checklist passes, then set to: live
META_PUBLISH_MODE=dry-run
# Verified Page conversation link, e.g. https://m.me/YourPageUsername  (m.me enables per-post attribution)
META_MESSENGER_URL=

# ---- Free AI (no paid fallback exists in the code) ----
# Gemini: https://aistudio.google.com/apikey  -> create the key in a project WITHOUT billing so it can never be charged
# Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# auto = use the chains below | template = offline development without any AI call
AI_PROVIDER=auto
# Tried in order; entries without an API key are skipped. Format provider:model
AI_CONTENT_CHAIN=gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
AI_CLASSIFIER_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-flash-lite-latest,gemini:gemini-flash-latest
AI_DAILY_REQUEST_LIMIT=150
AI_TIMEOUT_MS=40000
AI_CLASSIFIER_TIMEOUT_MS=12000
AI_TOTAL_BUDGET_MS=110000

# Public https address of THIS API deployment, e.g. https://tutorlink-agent-api.vercel.app
# Needed for the native "Send Message" button (Facebook fetches the post's card image from here). If empty on Vercel, the production URL is detected.
PUBLIC_API_URL=
# auto = try a link-card post with the native Send Message button, falling back to photo + link if Meta rejects it | photo = always photo + link
META_POST_STYLE=auto

# Optional FFmpeg override (normally leave empty; it is bundled)
FFMPEG_PATH=

# Background generation jobs
JOB_MAX_ATTEMPTS=1
JOB_LEASE_MS=360000
JOB_BATCH_SIZE=1

# Frequency guard enforced on every autonomous post
MAX_POSTS_PER_7_DAYS=7
MIN_HOURS_BETWEEN_POSTS=20
# With NO qualified/booked lead recorded in 7 days the agent waits this many hours between posts (40 = every 2nd daily run).
# Mark real enquiries as Qualified and it posts about daily. Set to 20 to post on every run regardless.
NO_LEAD_WAIT_HOURS=40
